<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Fondo de bienvenida"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_pantalla_de_inicio" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:weightSum="100">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="28"
            android:adjustViewBounds="true"
            android:contentDescription="Título NutriHierro"
            android:scaleType="fitCenter"
            android:src="@drawable/tiulo" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="36"
            android:adjustViewBounds="true"
            android:contentDescription="Mascota de la app"
            android:scaleType="fitCenter"
            android:src="@drawable/mascota_de_la_app" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="Sigue tu progreso"
                android:scaleType="fitCenter"
                android:src="@drawable/sigue_tu_progreso" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="Detecta síntomas"
                android:scaleType="fitCenter"
                android:src="@drawable/detecta_sintomas" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="Aliméntate mejor"
                android:scaleType="fitCenter"
                android:src="@drawable/alimentate_mejor" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="16"
            android:adjustViewBounds="true"
            android:background="@null"
            android:contentDescription="Comenzar"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/boton_comenzar" />

    </LinearLayout>

</FrameLayout>
