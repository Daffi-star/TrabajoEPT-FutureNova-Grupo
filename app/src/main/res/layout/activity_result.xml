<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvTituloResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resultado del Diagnóstico"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2D3748"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvRiesgoResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analizando..."
        android:textSize="20sp"
        android:textColor="#4A5568"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/tvMensajeRedireccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Serás redirigido al menú para continuar con tu plan y personalización"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textColor="#718096" />

</LinearLayout>